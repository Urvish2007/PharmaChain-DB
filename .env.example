# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# docker-compose.yml and application.yml both read these. Nothing here is required to change
# for local development except ANTHROPIC_API_KEY (only needed for the /api/v1/ai/** endpoints).
# .env is already in .gitignore - never commit a real one.

# --- Database (also used directly by `mvn spring-boot:run` outside Docker) ---
DB_HOST=localhost
DB_NAME=pharmachain
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# --- App container ---
APP_PORT=8080

# --- JWT ---
# Any long random string works. Override for anything beyond local development -
# generate one with: openssl rand -base64 48
JWT_SECRET=this-is-a-local-development-only-secret-change-it-before-deploying
JWT_EXPIRATION_MS=3600000

# --- Spring AI ---
# Required for /api/v1/ai/** - get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Where the app looks for Ollama (embeddings only - chat goes to Anthropic). The default
# assumes Ollama running on your HOST machine, reachable from inside the app container via
# Docker's host.docker.internal. If you instead run `docker compose --profile with-ai up`
# (containerizes Ollama too), change this to http://ollama:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_PORT=11434

# Skip the startup ingestion of compliance-docs/*.md into pgvector - e.g. if Ollama isn't
# reachable yet. Safe to leave true; ingestion is defensive and logs a warning rather than
# failing startup if the embedding model can't be reached.
INGEST_COMPLIANCE_DOCS=true
